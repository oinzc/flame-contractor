<?xml version="1.0" encoding="utf-8"?>
<!-- 7 日连胜卡 4×2（FlameStreak7DayWidgetProvider） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingTop="13dp"
    android:paddingEnd="15dp"
    android:paddingBottom="12dp">

    <!-- 顶部账号与状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_account_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="130dp"
            android:text="🔥 默认抖音号"
            android:textColor="#FFF4F5F7"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_ok_dark"
            android:maxLines="1"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:text="● 运行正常"
            android:textColor="#FF34D399"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:maxLines="1"
            android:text="--:--"
            android:textColor="#FF8A92A3"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/widget_refresh_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_refresh_bg_dark"
            android:contentDescription="@string/widget_refresh_content_description"
            android:padding="4.5dp"
            android:scaleType="centerInside"
            android:src="@drawable/widget_ic_refresh_dark" />
    </LinearLayout>

    <!-- 中部大数字 + 最高火花 + 渐变进度条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_hero_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0"
                android:textColor="#FFF4F5F7"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_hero_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="3dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="/ 0 位已完成"
                android:textColor="#FF8A92A3"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/widget_spark_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="3dp"
                android:background="@drawable/widget_spark_pill_dark"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="🔥 —"
                android:textColor="#FFFB923C"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_progress_bar_image"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="7dp"
            android:contentDescription="@null"
            android:scaleType="fitXY" />
    </LinearLayout>

    <!-- 底部近 7 日连胜方格 + 快捷链接 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_7day_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:maxLines="1"
            android:text="近7日"
            android:textColor="#FF8A92A3"
            android:textSize="10.5sp" />

        <ImageView
            android:id="@+id/widget_7day_strip_image"
            android:layout_width="156dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:scaleType="fitStart" />

        <TextView
            android:id="@+id/widget_action_link"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="@string/widget_action_scan_targets"
            android:textColor="#FFD1D5DB"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
