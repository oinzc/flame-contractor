<?xml version="1.0" encoding="utf-8"?>
<!-- 圆环全景卡 4×2（FlameStatusAppWidgetProvider） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="13dp"
    android:paddingEnd="14dp"
    android:paddingBottom="13dp">

    <!-- 左侧进度圆环 -->
    <FrameLayout
        android:id="@+id/widget_ring_container"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/widget_ring_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/widget_ring_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0/0"
                android:textColor="#FFF4F5F7"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_ring_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:text="今日进度"
                android:textColor="#FFA9B1BF"
                android:textSize="9.5sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 右侧账号状态、KPI 双微卡与底栏直达 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_account_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_placeholder_account"
                android:textColor="#FFF4F5F7"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_pill_ok_dark"
                android:maxLines="1"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="@string/widget_placeholder_status"
                android:textColor="#FF34D399"
                android:textSize="10sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="6dp">

                <ImageView
                    android:id="@+id/widget_refresh_button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_refresh_bg_dark"
                    android:contentDescription="@string/widget_refresh_content_description"
                    android:padding="4.5dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/widget_ic_refresh_dark" />

                <ProgressBar
                    android:id="@+id/widget_refresh_spinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_refresh_bg_dark"
                    android:indeterminate="true"
                    android:indeterminateTint="#FFF97316"
                    android:indeterminateTintMode="src_in"
                    android:padding="4.5dp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- 中部正常态双微卡 -->
        <LinearLayout
            android:id="@+id/widget_kpi_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_kpi_spark_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tile_dark"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp">

                <TextView
                    android:id="@+id/widget_kpi_spark_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="最高火花"
                    android:textColor="#FF8A92A3"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/widget_kpi_spark_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="#FFFB923C"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_kpi_next_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_tile_dark"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp">

                <TextView
                    android:id="@+id/widget_kpi_next_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="下次排程"
                    android:textColor="#FF8A92A3"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/widget_kpi_next_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:text="--:--"
                    android:textColor="#FFF4F5F7"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 异常告警说明文本（正常态隐藏） -->
        <TextView
            android:id="@+id/widget_alert_summary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:lineSpacingExtra="1.5dp"
            android:maxLines="2"
            android:text=""
            android:textColor="#FFD1D5DB"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- 底部直达栏 -->
        <LinearLayout
            android:id="@+id/widget_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_tile_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/widget_action_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="点击查看详情"
                android:textColor="#FFA9B1BF"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/widget_action_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="@string/widget_action_scan_targets"
                android:textColor="#FFF4F5F7"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
